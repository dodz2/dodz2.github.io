{
  "components": {
    "schemas": {
      "AuditResult": {
        "properties": {
          "checked_at": {
            "title": "Checked At",
            "type": "string"
          },
          "issue": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Issue"
          },
          "live_status": {
            "title": "Live Status",
            "type": "string"
          },
          "repository": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repository"
          },
          "risk_flags": {
            "items": {
              "type": "string"
            },
            "title": "Risk Flags",
            "type": "array"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "source",
          "checked_at",
          "url",
          "repository",
          "issue",
          "live_status",
          "risk_flags"
        ],
        "title": "AuditResult",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Live validation of public GitHub bounty issues.",
    "title": "Bounty Reality Check",
    "version": "1.0.0",
    "x-guidance": "Call GET /v1/audit with a canonical public GitHub issue URL. The route returns live issue and repository state plus explicit risk flags."
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [],
        "summary": "Health"
      }
    },
    "/v1/audit": {
      "get": {
        "operationId": "audit_v1_audit_get",
        "parameters": [
          {
            "description": "Canonical public GitHub issue URL",
            "in": "query",
            "name": "url",
            "required": true,
            "schema": {
              "description": "Canonical public GitHub issue URL",
              "title": "Url",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "402": {
            "description": "Payment Required"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Audit",
        "x-payment-info": {
          "price": {
            "amount": "0.010000",
            "currency": "USD",
            "mode": "fixed"
          },
          "protocols": [
            {
              "x402": {}
            }
          ]
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://kings-republicans-seq-facilities.trycloudflare.com"
    }
  ]
}
